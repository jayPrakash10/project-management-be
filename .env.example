NODE_ENV=development
PORT=3000

# Supabase -> Project Settings -> Database -> Connection string.
# If you use the Vercel <-> Supabase integration, POSTGRES_URL and
# POSTGRES_URL_NON_POOLING are picked up automatically as fallbacks.

# Pooled connection (Supavisor transaction mode, port 6543). Used by the running API.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Direct / session connection (port 5432). Used only by migrations and seeds.
DATABASE_URL_DIRECT=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Set to false only for a local Postgres without SSL.
DB_SSL=true

# Keep at 1 on Vercel: every serverless instance opens its own pool.
DB_POOL_MAX=1

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed origins, or * for any.
CORS_ORIGIN=*
